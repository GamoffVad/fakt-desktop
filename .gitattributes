# Исходный код: нормализация концов строк Git.
* text=auto

# Тестовые данные хранятся побайтно: окончания строк (LF, CRLF, CR, смешанные), кодировки
# и BOM — предмет проверки. Любое преобразование испортит эталон.
testdata/** -text -diff

# Двоичные файлы.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.xlsx binary
*.doc binary
*.bin binary
*.whl binary

# Файлы Windows-инструментов.
*.sln text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.iss text eol=crlf
*.reg text eol=crlf
