<UserControl x:Class="Fakt.Desktop.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls"
             xmlns:b="clr-namespace:Fakt.Desktop.Behaviors">
    <UserControl.Resources>
        <!-- Текстовая ячейка с подсветкой совпадений (исходный текст не изменяется). -->
        <DataTemplate x:Key="HighlightCell">
            <TextBlock Style="{StaticResource Text.Cell}" b:Highlight.Text="{Binding}"
                       b:Highlight.Terms="{Binding DataContext.HighlightTerms, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       ToolTip="{Binding}" />
        </DataTemplate>
        <Style x:Key="CardSectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading.Section}">
            <Setter Property="Margin" Value="0,16,0,8" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <DataTemplate x:Key="NameValueRow">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0" />
                <TextBox Grid.Column="1" Style="{StaticResource TextBox.Compact}" Text="{Binding DisplayValue, Mode=OneWay}" IsReadOnly="True" BorderThickness="0"
                         Background="Transparent" Padding="0" TextWrapping="Wrap" AutomationProperties.Name="{Binding Name}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid Margin="{StaticResource Thickness.Page}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,16">
                <TextBlock Style="{StaticResource Text.Heading.Page}" Text="Поиск" />
                <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="Поиск по сохранённым наблюдениям: ФИО, дата и место рождения, факты из [ALL], имя и код файла. Совпадение имён не означает тождество людей — карточки не объединяются." />
            </StackPanel>

            <!-- Строка поиска и фильтры -->
            <Border Grid.Row="1" Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Сбросить" ui:Ui.Icon="{StaticResource Icon.Reset}" Command="{Binding ResetCommand}" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Отменить" Command="{Binding CancelCommand}" Margin="8,0,0,0"
                                Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Content="Найти" ui:Ui.Icon="{StaticResource Icon.Search}"
                                ui:Ui.IsBusy="{Binding IsSearching}" Command="{Binding SearchCommand}" Margin="8,0,0,0" />
                        <ComboBox DockPanel.Dock="Right" Width="210" Margin="8,0,0,0" ItemsSource="{Binding Modes}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Mode}" AutomationProperties.Name="Режим поиска" />
                        <TextBox x:Name="QueryBox" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}"
                                 ui:Ui.Placeholder="Фамилия, имя, телефон, номер счёта, имя или код файла…" AutomationProperties.Name="Строка поиска" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ModeHint}" TextWrapping="Wrap" Margin="0,6,0,0" />
                    <Expander Header="Дополнительные фильтры" IsExpanded="{Binding FiltersExpanded}" Margin="0,8,0,0">
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Фамилия" />
                                <TextBox Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Фамилия" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Имя" />
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Имя" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Отчество" />
                                <TextBox Text="{Binding Patronymic, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Отчество" />
                            </StackPanel>
                            <StackPanel Grid.Column="6" VerticalAlignment="Bottom">
                                <CheckBox Content="ФИО точно (иначе — по началу)" IsChecked="{Binding NamesExact}" Margin="0,0,0,10" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Дата рождения с (ДД.ММ.ГГГГ)" />
                                <TextBox Text="{Binding DateFrom, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Дата рождения с" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="по (пусто — точная дата)" />
                                <TextBox Text="{Binding DateTo, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Дата рождения по" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="4" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Место рождения" />
                                <TextBox Text="{Binding BirthPlace, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Место рождения" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="6" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Тип факта" />
                                <ComboBox ItemsSource="{Binding FactTypes}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding FactType}" AutomationProperties.Name="Тип факта" />
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Телефон, счёт или иной идентификатор" />
                                <TextBox Text="{Binding Identifier, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}"
                                         ToolTip="Сравнивается нормализованное значение: +7 (000) 123-45-67 и 70001234567 совпадают; код страны не добавляется" AutomationProperties.Name="Идентификатор" />
                                <CheckBox Content="По началу значения" IsChecked="{Binding IdentifierPrefix}" Margin="0,6,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Имя файла" />
                                <TextBox Text="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Имя файла" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Код файла (T_…)" />
                                <TextBox Text="{Binding FileCode, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="Код файла" />
                            </StackPanel>
                            <Grid Grid.Row="2" Grid.Column="6" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="ID наблюдения" />
                                    <TextBox Text="{Binding PersonFactId, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="ID наблюдения" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource Text.FieldLabel}" Text="ID файла" />
                                    <TextBox Text="{Binding FileId, UpdateSourceTrigger=PropertyChanged}" b:EnterKey.Command="{Binding SearchCommand}" AutomationProperties.Name="ID файла" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Сообщения -->
            <StackPanel Grid.Row="2">
                <Border Style="{StaticResource Banner.Error}" Margin="0,0,0,12" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource Banner.Info}" Margin="0,0,0,12" Visibility="{Binding Notices, Converter={StaticResource NullToVisibility}}">
                    <TextBlock Text="{Binding Notices}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>

            <!-- Результаты -->
            <Border Grid.Row="3" Style="{StaticResource Panel.Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Heading.Section}" Text="Результаты" VerticalAlignment="Center" />
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Secondary}" Text="{Binding CountText}" VerticalAlignment="Center" Margin="16,0,16,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Следующая" ui:Ui.Icon="{StaticResource Icon.ChevronRight}" Command="{Binding NextPageCommand}" Margin="8,0,0,0" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Label}" Text="{Binding PageText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Предыдущая" ui:Ui.Icon="{StaticResource Icon.ChevronLeft}" Command="{Binding PrevPageCommand}" />
                        <ComboBox DockPanel.Dock="Right" Width="210" Margin="0,0,16,0" ItemsSource="{Binding Sorts}" DisplayMemberPath="Value" SelectedValuePath="Key"
                                  SelectedValue="{Binding Sort}" AutomationProperties.Name="Сортировка" ToolTip="Сортировка применяется при следующем поиске" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Caption}" Text="{Binding Status}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    </DockPanel>
                    <Grid>
                        <DataGrid Style="{StaticResource DataGrid.Results}" ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" FrozenColumnCount="2"
                                  b:RowActivation.Command="{Binding OpenCardCommand}" AutomationProperties.Name="Результаты поиска"
                                  ToolTip="Щелчок по строке или Enter — карточка наблюдения со всеми фактами">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID наблюдения" Binding="{Binding PersonFactId}" Width="132" MinWidth="132" ElementStyle="{StaticResource Text.Cell.Numeric}" />
                                <DataGridTemplateColumn Header="Фамилия" Width="*" MinWidth="120" SortMemberPath="Surname">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Surname}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Имя" Width="*" MinWidth="100" SortMemberPath="Name">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Name}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Отчество" Width="*" MinWidth="110" SortMemberPath="Patronymic">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding Patronymic}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Дата рождения" Binding="{Binding BirthDate}" Width="132" MinWidth="132" ElementStyle="{StaticResource Text.Cell}" />
                                <DataGridTemplateColumn Header="Место рождения" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding BirthPlace}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Факты ([ALL], кратко)" Width="2.4*" MinWidth="200">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding FactsSummary}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Код файла" Width="180" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding FileCode}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Имя файла" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentPresenter Content="{Binding FileName}" ContentTemplate="{StaticResource HighlightCell}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID файла" Binding="{Binding FileId}" Width="96" MinWidth="96" ElementStyle="{StaticResource Text.Cell.Numeric}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding EmptyStateText}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" IsHitTestVisible="False"
                                   Visibility="{Binding EmptyStateText, Converter={StaticResource NullToVisibility}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Всплывающая карточка наблюдения -->
        <Grid x:Name="CardOverlay" Visibility="{Binding Card, Converter={StaticResource NullToVisibility}}" IsVisibleChanged="OnOverlayVisibleChanged"
              KeyboardNavigation.TabNavigation="Cycle">
            <Grid.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseCardCommand}" />
            </Grid.InputBindings>
            <Border Background="{DynamicResource Brush.Background.App}" Opacity="0.88" MouseLeftButtonDown="OnOverlayBackgroundClick" />
            <Border Style="{StaticResource Panel.Card}" DataContext="{Binding Card}" MaxWidth="1040" Margin="32" BorderBrush="{DynamicResource Brush.Border.Input}"
                    AutomationProperties.Name="Карточка наблюдения">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button x:Name="CloseCardButton" DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ui:Ui.Icon="{StaticResource Icon.Close}"
                                Command="{Binding CloseCommand}" ToolTip="Закрыть (Esc)" AutomationProperties.Name="Закрыть карточку" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Heading.Page}" TextWrapping="Wrap"
                                       b:Highlight.Text="{Binding Title}" b:Highlight.Terms="{Binding HighlightTerms}" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:StatusBadge Text="{Binding IdentityText}" Tone="Info" Margin="0,0,8,0" Visibility="{Binding IdentityText, Converter={StaticResource NullToVisibility}}" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding KindText}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Content="Копировать JSON" ui:Ui.Icon="{StaticResource Icon.Copy}" Command="{Binding CopyJsonCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Копировать карточку" ui:Ui.Icon="{StaticResource Icon.Copy}" Command="{Binding CopyCardCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Secondary}" Content="Показать исходный файл" ui:Ui.Icon="{StaticResource Icon.FolderOpen}" Command="{Binding ShowFileCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}" Content="Закрыть" Command="{Binding CloseCommand}" Margin="0,0,16,0" />
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CopyStatus}" VerticalAlignment="Center" />
                    </StackPanel>
                    <Grid>
                        <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                        <Border Style="{StaticResource Banner.Error}" VerticalAlignment="Top" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
                            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
                        </Border>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource CardSectionTitle}" Text="Основные сведения" Margin="0,0,0,8" />
                                <ItemsControl ItemsSource="{Binding MainFields}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" />

                                <TextBlock Style="{StaticResource CardSectionTitle}" Text="Факты из [ALL]" />
                                <TextBlock Style="{StaticResource Text.Secondary}" Text="Дополнительных фактов нет." Visibility="{Binding HasFacts, Converter={StaticResource InverseBoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding FactGroups}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding Title}" Margin="0,0,0,4" />
                                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,0,0,1" Padding="0,4">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                                                                               b:Highlight.Text="{Binding Value}"
                                                                               b:Highlight.Terms="{Binding DataContext.HighlightTerms, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" />
                                                                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                                                                        <Run Text="{Binding Label, Mode=OneWay, StringFormat={}{0} · , TargetNullValue=''}" />
                                                                        <Run Text="{Binding Normalized, Mode=OneWay, StringFormat=нормализовано: {0} · , TargetNullValue=''}" />
                                                                        <Run Text="{Binding Source, Mode=OneWay, StringFormat=столбец «{0}», TargetNullValue='столбец не указан'}" />
                                                                        <Run Text="{Binding Evidence, Mode=OneWay, StringFormat= · фрагмент: «{0}», TargetNullValue=''}" />
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <StackPanel Visibility="{Binding HasUnresolved, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource CardSectionTitle}" Text="Неразрешённые значения (не записаны в основные поля)" />
                                    <ItemsControl ItemsSource="{Binding Unresolved}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource CardSectionTitle}" Text="Предупреждения проверки" />
                                    <ItemsControl ItemsSource="{Binding Warnings}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding StringFormat=• {0}}" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <Expander Header="Отклонённые кандидаты модели (не подтверждены записью)" Margin="0,12,0,0"
                                          Visibility="{Binding HasRejected, Converter={StaticResource BoolToVisibility}}">
                                    <ItemsControl ItemsSource="{Binding Rejected}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" Margin="0,8,0,0" />
                                </Expander>

                                <TextBlock Style="{StaticResource CardSectionTitle}" Text="Происхождение" />
                                <ItemsControl ItemsSource="{Binding Provenance}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" />

                                <Expander Header="Все поля таблицы PersonFacts" Margin="0,16,0,0">
                                    <ItemsControl ItemsSource="{Binding PersonFactsColumns}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" Margin="0,8,0,0" />
                                </Expander>
                                <Expander Header="Все поля таблицы SourceFiles (исходный файл)" Margin="0,8,0,0">
                                    <ItemsControl ItemsSource="{Binding SourceFilesColumns}" ItemTemplate="{StaticResource NameValueRow}" Focusable="False" Margin="0,8,0,0" />
                                </Expander>
                                <Expander Header="JSON [ALL] полностью" Margin="0,8,0,0">
                                    <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Json, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}"
                                             MaxHeight="420" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                             AutomationProperties.Name="JSON поля ALL" />
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
