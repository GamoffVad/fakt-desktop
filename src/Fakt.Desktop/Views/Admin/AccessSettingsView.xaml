<UserControl x:Class="Fakt.Desktop.Views.Admin.AccessSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls"
             xmlns:b="clr-namespace:Fakt.Desktop.Behaviors">
    <UserControl.Resources>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading.Section}">
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Список учётных записей роли: имя, SID, кнопка удаления. -->
        <DataTemplate x:Key="PrincipalTemplate">
            <Border BorderBrush="{DynamicResource Brush.Border.Subtle}" BorderThickness="0,1,0,0" Padding="0,6">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ui:Ui.Icon="{StaticResource Icon.Trash}" ToolTip="Убрать из роли"
                            AutomationProperties.Name="Убрать из роли"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                    <ui:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.User}" Size="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Sid, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
        <StackPanel Margin="0,0,12,16">
            <Border Style="{StaticResource Banner.ByKind}" Margin="0,0,0,16" Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Текущий пользователь" Margin="0,0,0,8" />
                    <DockPanel>
                        <ui:Icon DockPanel.Dock="Left" Data="{StaticResource Icon.Shield}" Size="18" Margin="0,0,8,0" VerticalAlignment="Top" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding CurrentUser}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Text.Secondary}" Text="{Binding OwnerText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Margin="0,12,0,0"
                               Text="Роли назначаются учётным записям и группам Windows (по SID). Администратор настраивает подключения, миграции и доступ; Оператор выполняет обработку и поиск. Права проверяются при каждом действии, а не только при отображении кнопок." />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Panel.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Администраторы" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Все настройки, миграции базы, роли, обработка и поиск." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Administrators}" ItemTemplate="{StaticResource PrincipalTemplate}" Tag="{Binding RemoveAdminCommand}"
                                      IsEnabled="{Binding CanEdit}" Focusable="False" />
                        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding CanEdit}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Добавить" ui:Ui.Icon="{StaticResource Icon.Plus}"
                                    Command="{Binding AddAdminCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewAdmin, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ДОМЕН\имя, КОМПЬЮТЕР\группа или SID"
                                     b:EnterKey.Command="{Binding AddAdminCommand}" AutomationProperties.Name="Новый администратор" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel.Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Операторы" />
                        <TextBlock Style="{StaticResource Text.Secondary}" Text="Обработка файлов, поиск, история заданий и журнал без изменения настроек." TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PrincipalTemplate}" Tag="{Binding RemoveOperatorCommand}"
                                      IsEnabled="{Binding CanEdit}" Focusable="False" />
                        <DockPanel Margin="0,12,0,0" IsEnabled="{Binding CanEdit}">
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Добавить" ui:Ui.Icon="{StaticResource Icon.Plus}"
                                    Command="{Binding AddOperatorCommand}" Margin="8,0,0,0" />
                            <TextBox Text="{Binding NewOperator, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ДОМЕН\имя, КОМПЬЮТЕР\группа или SID"
                                     b:EnterKey.Command="{Binding AddOperatorCommand}" AutomationProperties.Name="Новый оператор" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel IsEnabled="{Binding CanEdit}">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Хранение ключей API и пароля SQL" />
                    <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Секреты шифруются DPAPI и хранятся отдельно от файла настроек; в журнал, экспорт задания и командную строку worker они не попадают." />
                    <RadioButton GroupName="SecretScope" IsChecked="{Binding ScopeCurrentUser}" Margin="0,0,0,8"
                                 Content="Только для текущего пользователя Windows (другие администраторы вводят свои ключи)" />
                    <RadioButton GroupName="SecretScope" IsChecked="{Binding ScopeLocalMachine}"
                                 Content="Для этого компьютера (доступ к файлам секретов — только у администраторов FAKT по ACL)" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource Button.Primary}" Content="Сохранить роли" ui:Ui.Icon="{StaticResource Icon.Save}" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
