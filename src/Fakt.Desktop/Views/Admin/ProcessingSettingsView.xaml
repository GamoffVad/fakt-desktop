<UserControl x:Class="Fakt.Desktop.Views.Admin.ProcessingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,16,12" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading.Section}">
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,16,0,0">
        <StackPanel Margin="0,0,12,16" IsEnabled="{Binding CanEdit}">

            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Поиск файлов" />
                    <CheckBox Content="Искать во вложенных папках" IsChecked="{Binding RecursiveScan}" Margin="0,0,0,8" />
                    <CheckBox Content="Включать скрытые и системные файлы" IsChecked="{Binding IncludeHidden}" Margin="0,0,0,8" />
                    <CheckBox Content="Переходить по символическим ссылкам и junction (циклы обнаруживаются по идентификатору файла)" IsChecked="{Binding FollowReparsePoints}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Определение структуры" />
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Строк в образце для модели" />
                            <TextBox Text="{Binding SampleLines, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Предел образца, КиБ" />
                            <TextBox Text="{Binding SampleMaxKb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Записей в предпросмотре" />
                            <TextBox Text="{Binding PreviewRecords, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Строк в расширенном образце" />
                            <TextBox Text="{Binding ExtendedLines, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Предел расширенного образца, КиБ" />
                            <TextBox Text="{Binding ExtendedMaxKb, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Подтверждать, если запросов структуры больше" />
                            <TextBox Text="{Binding ConfirmAbove, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="По умолчанию модели отправляются первые 5 строк файла. Расширенный образец используется, только если по первым строкам структура не определяется, и только после подтверждения." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Panel.Card}" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="Чтение, запись и ограничения" />
                    <UniformGrid Columns="3">
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Записей в chunk Pandas" />
                            <TextBox Text="{Binding ChunkSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Строк в SQL-пакете" />
                            <TextBox Text="{Binding SqlBatchSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Предел очереди, пакетов" />
                            <TextBox Text="{Binding QueueCapacity, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Попыток на запрос к LLM" />
                            <TextBox Text="{Binding MaxAttempts, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Предел запросов задания (0 — нет)" />
                            <TextBox Text="{Binding BudgetRequests, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Field}">
                            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Предел токенов задания (0 — нет)" />
                            <TextBox Text="{Binding BudgetTokens, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="При достижении предела запросов или токенов задание приостанавливается с сохранением прогресса; продолжить можно после подтверждения." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Banner.ByKind}" Margin="0,0,0,12" Visibility="{Binding Message, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
            </Border>
            <WrapPanel>
                <Button Style="{StaticResource Button.Primary}" Content="Сохранить параметры обработки" ui:Ui.Icon="{StaticResource Icon.Save}" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                <Button Style="{StaticResource Button.Ghost}" Content="Значения по умолчанию" ui:Ui.Icon="{StaticResource Icon.Refresh}" Command="{Binding ResetDefaultsCommand}" Margin="0,0,8,8"
                        ToolTip="Рекомендуемые параметры обработки; сохраняются кнопкой «Сохранить параметры обработки»" />
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
