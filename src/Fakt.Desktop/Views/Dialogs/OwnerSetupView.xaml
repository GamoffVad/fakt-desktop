<UserControl x:Class="Fakt.Desktop.Views.Dialogs.OwnerSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls"
             xmlns:b="clr-namespace:Fakt.Desktop.Behaviors">
    <UserControl.Resources>
        <DataTemplate x:Key="PrincipalTemplate">
            <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" ui:Ui.Icon="{StaticResource Icon.Close}" ToolTip="Убрать" AutomationProperties.Name="Убрать"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" />
                <TextBlock Style="{StaticResource Text.Body}" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Настройки FAKT на этом компьютере ещё не созданы. Первый запустивший становится владельцем и получает роль «Администратор». Паролей по умолчанию нет: роли привязаны к учётным записям и группам Windows." />
        <Border Style="{StaticResource Panel.Subtle}" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Label}" Text="{Binding CurrentUser, Mode=OneWay}" />
                <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CurrentSid, Mode=OneWay}" FontFamily="{StaticResource Font.Mono}" />
                <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap">
                    <Run Text="Каталог настроек: " /><Run Text="{Binding ConfigFolder, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Дополнительные администраторы (необязательно)" />
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Добавить" Command="{Binding AddAdminCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding AdminName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ДОМЕН\имя или группа" b:EnterKey.Command="{Binding AddAdminCommand}"
                             AutomationProperties.Name="Администратор" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Administrators}" ItemTemplate="{StaticResource PrincipalTemplate}" Focusable="False" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Операторы (необязательно)" />
                <DockPanel Margin="0,4,0,8">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Content="Добавить" Command="{Binding AddOperatorCommand}" Margin="8,0,0,0" />
                    <TextBox Text="{Binding OperatorName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ДОМЕН\имя или группа" b:EnterKey.Command="{Binding AddOperatorCommand}"
                             AutomationProperties.Name="Оператор" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Operators}" ItemTemplate="{StaticResource PrincipalTemplate}" Focusable="False" />
            </StackPanel>
        </Grid>
        <CheckBox Content="Хранить ключи API и пароль SQL для всего компьютера (иначе — только для текущего пользователя)" IsChecked="{Binding MachineScope}" Margin="0,12,0,0" />
        <Border Style="{StaticResource Banner.Error}" Margin="0,12,0,0" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
