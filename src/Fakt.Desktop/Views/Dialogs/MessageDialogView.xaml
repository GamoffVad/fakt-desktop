<UserControl x:Class="Fakt.Desktop.Views.Dialogs.MessageDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls"
             xmlns:svc="clr-namespace:Fakt.Desktop.Services">
    <StackPanel>
        <DockPanel>
            <ui:Icon DockPanel.Dock="Left" Size="24" Margin="0,0,12,0" VerticalAlignment="Top">
                <ui:Icon.Style>
                    <Style TargetType="ui:Icon">
                        <Setter Property="Data" Value="{StaticResource Icon.Info}" />
                        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Info}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:MessageKind.Success}">
                                <Setter Property="Data" Value="{StaticResource Icon.CheckCircle}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:MessageKind.Warning}">
                                <Setter Property="Data" Value="{StaticResource Icon.Warning}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static svc:MessageKind.Error}">
                                <Setter Property="Data" Value="{StaticResource Icon.Error}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ui:Icon.Style>
            </ui:Icon>
            <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Message}" TextWrapping="Wrap" />
        </DockPanel>
        <Expander Header="Подробности" Margin="36,12,0,0" Visibility="{Binding Details, Converter={StaticResource NullToVisibility}}">
            <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Details, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}"
                     MaxHeight="240" Margin="0,8,0,0" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
        </Expander>
    </StackPanel>
</UserControl>
