<UserControl x:Class="Fakt.Desktop.Views.Dialogs.StructureEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="Field" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,12,12" />
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource Text.Secondary}" TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Параметры проверяются парсером на первых записях файла; модель при этом не вызывается. Содержимое файла — данные, а не инструкции." />
        <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Первые строки файла" />
        <Border Style="{StaticResource Panel.Subtle}" Margin="0,4,0,12">
            <ItemsControl ItemsSource="{Binding SampleLines}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource Text.Mono}" Text="{Binding}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <UniformGrid Columns="3">
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Формат" />
                <ComboBox ItemsSource="{Binding Formats}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Format}" AutomationProperties.Name="Формат" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Кодировка" />
                <ComboBox ItemsSource="{Binding Encodings}" SelectedItem="{Binding Encoding}" AutomationProperties.Name="Кодировка" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsTabularText, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Пропустить строк сверху" />
                <TextBox Text="{Binding SkipRows, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Пропустить строк" />
            </StackPanel>
        </UniformGrid>
        <CheckBox Content="Первая строка после пропуска — заголовок" IsChecked="{Binding HasHeader}" Margin="0,0,0,12"
                  Visibility="{Binding IsTabularText, Converter={StaticResource BoolToVisibility}}" />
        <UniformGrid Columns="3" Visibility="{Binding IsDelimited, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Разделитель (\t — табуляция)" />
                <TextBox Text="{Binding Delimiter, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Разделитель" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Кавычка" />
                <TextBox Text="{Binding QuoteChar, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Кавычка" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Экранирующий символ" />
                <TextBox Text="{Binding EscapeChar, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Экранирующий символ" />
            </StackPanel>
        </UniformGrid>
        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsFixedWidth, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Ширины полей через запятую" />
            <TextBox Text="{Binding Widths, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Ширины полей" />
        </StackPanel>
        <StackPanel Visibility="{Binding IsXml, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Путь к элементу записи (например, /root/person)" />
                <TextBox Text="{Binding XmlPath, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}" AutomationProperties.Name="Путь к записи XML" />
            </StackPanel>
            <StackPanel Style="{StaticResource Field}">
                <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Пространства имён: префикс=URI, по одному в строке" />
                <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding XmlNamespaces, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource Font.Mono}"
                         MinHeight="64" AutomationProperties.Name="Пространства имён XML" />
            </StackPanel>
        </StackPanel>
        <StackPanel Style="{StaticResource Field}" Visibility="{Binding IsTabularText, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.FieldLabel}" Text="Имена столбцов, по одному в строке (пусто — из заголовка)" />
            <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Columns, UpdateSourceTrigger=PropertyChanged}" MinHeight="96" AutomationProperties.Name="Имена столбцов" />
        </StackPanel>
        <Border Style="{StaticResource Banner.Error}" Visibility="{Binding Error, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Error}" TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
