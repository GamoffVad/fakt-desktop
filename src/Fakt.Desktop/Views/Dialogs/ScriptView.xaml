<UserControl x:Class="Fakt.Desktop.Views.Dialogs.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Fakt.Desktop.Controls">
    <StackPanel>
        <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Description, Mode=OneWay}" TextWrapping="Wrap" Margin="0,0,0,12" />
        <Border Style="{StaticResource Banner.Warning}" Margin="0,0,0,12" Visibility="{Binding IsDanger, Converter={StaticResource BoolToVisibility}}">
            <TextBlock TextWrapping="Wrap" Text="Миграция добавляет столбцы или индексы в основные таблицы. Данные не удаляются, но на больших таблицах операция может занять время и удерживать блокировки." />
        </Border>
        <TextBox Style="{StaticResource TextBox.Multiline}" Text="{Binding Script, Mode=OneWay}" IsReadOnly="True" FontFamily="{StaticResource Font.Mono}"
                 Height="360" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="SQL миграции" />
        <Button Style="{StaticResource Button.Ghost}" Content="Копировать SQL" ui:Ui.Icon="{StaticResource Icon.Copy}" Command="{Binding CopyCommand}"
                HorizontalAlignment="Left" Margin="0,8,0,0" />
    </StackPanel>
</UserControl>
