<Application x:Class="Fakt.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Fakt.Desktop.Converters"
             xmlns:svc="clr-namespace:Fakt.Desktop.Services"
             xmlns:vm="clr-namespace:Fakt.Desktop.ViewModels"
             xmlns:avm="clr-namespace:Fakt.Desktop.ViewModels.Admin"
             xmlns:views="clr-namespace:Fakt.Desktop.Views"
             xmlns:admin="clr-namespace:Fakt.Desktop.Views.Admin"
             xmlns:dialogs="clr-namespace:Fakt.Desktop.Views.Dialogs"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/ArcticBlue.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVisibility" Invert="True" />
            <conv:NullToVisibilityConverter x:Key="NullToVisibility" />
            <conv:NullToVisibilityConverter x:Key="InverseNullToVisibility" Invert="True" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:CountToVisibilityConverter x:Key="InverseCountToVisibility" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:FileSizeConverter x:Key="FileSize" />
            <conv:LocalDateTimeConverter x:Key="LocalDateTime" />
            <conv:LocalDateTimeConverter x:Key="LocalDate" Format="dd.MM.yyyy" />
            <conv:NumberConverter x:Key="Number" />
            <conv:ToneConverter x:Key="Tone" />
            <conv:EqualityToBoolConverter x:Key="EqualityToBool" />
            <conv:FileStatusTextConverter x:Key="StatusText" />

            <!-- Сообщение модели представления: цвет по MessageKind (Info/Success/Warning/Error). -->
            <Style x:Key="Banner.ByKind" TargetType="Border" BasedOn="{StaticResource Banner.Info}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static svc:MessageKind.Success}">
                        <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.SuccessBorder}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static svc:MessageKind.Warning}">
                        <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.WarningBorder}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MessageKind}" Value="{x:Static svc:MessageKind.Error}">
                        <Setter Property="Background" Value="{DynamicResource Brush.Status.ErrorBackground}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.ErrorBorder}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Ячейка предпросмотра: NULL, пустая строка и пробелы показываются по-разному (Behaviors.PreviewColumns). -->
            <DataTemplate x:Key="PreviewCellTemplate" DataType="{x:Type vm:PreviewCell}">
                <TextBlock x:Name="Value" Text="{Binding Text, Mode=OneWay}" ToolTip="{Binding ToolTip, Mode=OneWay}" Style="{StaticResource Text.Cell}" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsSpecial}" Value="True">
                        <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                        <Setter TargetName="Value" Property="FontStyle" Value="Italic" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!-- Страницы -->
            <DataTemplate DataType="{x:Type vm:ProcessingViewModel}">
                <views:ProcessingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SearchViewModel}">
                <views:SearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryViewModel}">
                <views:HistoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type avm:AdminViewModel}">
                <admin:AdminView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogViewModel}">
                <views:LogView />
            </DataTemplate>

            <!-- Содержимое диалогов -->
            <DataTemplate DataType="{x:Type svc:MessageDialogViewModel}">
                <dialogs:MessageDialogView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:EstimateViewModel}">
                <dialogs:EstimateView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:StructureEditorViewModel}">
                <dialogs:StructureEditorView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HelpViewModel}">
                <dialogs:HelpView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type avm:ScriptViewModel}">
                <dialogs:ScriptView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:OwnerSetupViewModel}">
                <dialogs:OwnerSetupView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
