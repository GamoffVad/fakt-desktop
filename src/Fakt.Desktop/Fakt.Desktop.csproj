<Project Sdk="Microsoft.NET.Sdk">
  <!-- WPF-клиент FAKT: .NET Framework 4.8, Windows 7 SP1 x64. MVVM, тема Arctic Blue. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>false</UseWindowsForms>
    <RootNamespace>Fakt.Desktop</RootNamespace>
    <AssemblyName>FAKT</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fakt.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Data" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fakt.Core\Fakt.Core.csproj" />
    <ProjectReference Include="..\Fakt.Application\Fakt.Application.csproj" />
    <ProjectReference Include="..\Fakt.Infrastructure\Fakt.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\fakt.ico" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fakt.UnitTests" />
  </ItemGroup>
</Project>
