<!--
    FAKT · Arctic Blue · Layer 1: primitives (DESIGN.md §3.1).
    The ONLY place where HEX values live. Everything else references these keys
    through ArcticBlue.Semantic.xaml.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Surfaces -->
    <Color x:Key="Color.Ice.50">#EDF4FA</Color>
    <Color x:Key="Color.White">#FFFFFF</Color>

    <!-- Text / brand -->
    <Color x:Key="Color.Navy.800">#153C62</Color>

    <!-- Accent (actions, focus) -->
    <Color x:Key="Color.Ocean.600">#087EA4</Color>
    <Color x:Key="Color.Ocean.700">#066B8C</Color>
    <Color x:Key="Color.Ocean.800">#055570</Color>

    <!-- Blue tints (secondary surfaces, navigation, selection, dividers) -->
    <Color x:Key="Color.Blue.50">#F4F9FD</Color>
    <Color x:Key="Color.Blue.100">#E3F0FA</Color>
    <Color x:Key="Color.Blue.200">#D3E9F8</Color>
    <Color x:Key="Color.Blue.300">#C5DCEC</Color>

    <!-- Slate (input borders, secondary text, disabled) -->
    <Color x:Key="Color.Slate.200">#DDE6ED</Color>
    <Color x:Key="Color.Slate.400">#7894A8</Color>
    <Color x:Key="Color.Slate.500">#64788A</Color>
    <Color x:Key="Color.Slate.600">#526B82</Color>

    <!-- Status: success -->
    <Color x:Key="Color.Green.50">#E4F5ED</Color>
    <Color x:Key="Color.Green.700">#08785D</Color>

    <!-- Status: warning. Amber.500 is an accent for icons only, never for small text on white. -->
    <Color x:Key="Color.Amber.50">#FFF3DB</Color>
    <Color x:Key="Color.Amber.100">#FFE9A8</Color>
    <Color x:Key="Color.Amber.500">#F59E0B</Color>
    <Color x:Key="Color.Amber.800">#92400E</Color>

    <!-- Status: error -->
    <Color x:Key="Color.Red.50">#FDECEF</Color>
    <Color x:Key="Color.Red.100">#F9D7DC</Color>
    <Color x:Key="Color.Red.700">#B42332</Color>

    <!-- Motion (DESIGN.md §9): hover/focus 100-150 ms, small notifications up to 180 ms. -->
    <Duration x:Key="Duration.Hover">0:0:0.12</Duration>
    <Duration x:Key="Duration.Notification">0:0:0.18</Duration>
    <sys:TimeSpan x:Key="TimeSpan.Hover">0:0:0.12</sys:TimeSpan>

</ResourceDictionary>
