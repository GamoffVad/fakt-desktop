<!--
    FAKT · Arctic Blue · Layer 2: semantic brushes (DESIGN.md §3.2).
    Control templates reference these keys with DynamicResource. Brushes are frozen
    (never animate them; templates animate their own local layers instead).
    Merges ArcticBlue.Primitives.xaml itself (StaticResource needs the colours in scope).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    mc:Ignorable="po">

    <!-- Token dictionaries referenced with StaticResource by this file (StaticResource does not
         see sibling merged dictionaries, so every dictionary merges what it needs itself). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ArcticBlue.Primitives.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="Brush.Background.App" Color="{StaticResource Color.Ice.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Background.Surface" Color="{StaticResource Color.White}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Background.Subtle" Color="{StaticResource Color.Blue.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Background.Navigation" Color="{StaticResource Color.Blue.100}" po:Freeze="True"/>
    <!-- Inverse surface: tooltips -->
    <SolidColorBrush x:Key="Brush.Background.Inverse" Color="{StaticResource Color.Navy.800}" po:Freeze="True"/>

    <!-- Text -->
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Navy.800}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Slate.600}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnAction" Color="{StaticResource Color.White}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Text.OnInverse" Color="{StaticResource Color.White}" po:Freeze="True"/>
    <!-- Links use Ocean.700: Ocean.600 is only 4.2:1 on the Ice.50 app background. -->
    <SolidColorBrush x:Key="Brush.Text.Link" Color="{StaticResource Color.Ocean.700}" po:Freeze="True"/>

    <!-- Borders -->
    <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{StaticResource Color.Blue.300}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Border.Input" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/>

    <!-- Actions -->
    <SolidColorBrush x:Key="Brush.Action.Primary" Color="{StaticResource Color.Ocean.600}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Action.Hover" Color="{StaticResource Color.Ocean.700}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Action.Pressed" Color="{StaticResource Color.Ocean.800}" po:Freeze="True"/>

    <!-- Focus / selection / highlight -->
    <SolidColorBrush x:Key="Brush.Focus" Color="{StaticResource Color.Ocean.600}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="{StaticResource Color.Blue.200}" po:Freeze="True"/>
    <!-- Search-match highlight behind Navy text (Run.Background); Navy on it is 9.4:1. Stronger than
         Amber.50 (warning background) so matches stay visible on white and on selected rows. -->
    <SolidColorBrush x:Key="Brush.Highlight" Color="{StaticResource Color.Amber.100}" po:Freeze="True"/>

    <!-- Disabled -->
    <SolidColorBrush x:Key="Brush.Disabled.Background" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Disabled.Foreground" Color="{StaticResource Color.Slate.500}" po:Freeze="True"/>

    <!-- Status: text/icon colour + light background (+ low-emphasis border for banners) -->
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Green.700}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessBackground" Color="{StaticResource Color.Green.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.SuccessBorder" Color="{StaticResource Color.Green.700}" Opacity="0.35" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Amber.800}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.WarningBackground" Color="{StaticResource Color.Amber.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.WarningBorder" Color="{StaticResource Color.Amber.500}" Opacity="0.55" po:Freeze="True"/>
    <!-- Amber accent for warning ICONS only (never for text: 2.1:1 on white). -->
    <SolidColorBrush x:Key="Brush.Status.WarningAccent" Color="{StaticResource Color.Amber.500}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Red.700}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.ErrorBackground" Color="{StaticResource Color.Red.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.ErrorBackgroundStrong" Color="{StaticResource Color.Red.100}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.ErrorBorder" Color="{StaticResource Color.Red.700}" Opacity="0.35" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Ocean.700}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.InfoBackground" Color="{StaticResource Color.Blue.100}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.InfoBorder" Color="{StaticResource Color.Blue.300}" po:Freeze="True"/>

    <SolidColorBrush x:Key="Brush.Status.Neutral" Color="{StaticResource Color.Slate.600}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.NeutralBackground" Color="{StaticResource Color.Blue.50}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Status.NeutralBorder" Color="{StaticResource Color.Blue.300}" po:Freeze="True"/>

    <!-- Scrollbars / progress -->
    <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="{StaticResource Color.Slate.600}" po:Freeze="True"/>
    <SolidColorBrush x:Key="Brush.Progress.Track" Color="{StaticResource Color.Blue.100}" po:Freeze="True"/>

</ResourceDictionary>
