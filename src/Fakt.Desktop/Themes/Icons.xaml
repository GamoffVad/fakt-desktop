    <!--
        ui:Icon: Viewbox (Size×Size) > Canvas 24×24 > Path. Stroke = Foreground (inherited from the
        parent's TextElement.Foreground), 2 units, round caps/joins, no fill. IsFilled=True fills instead.
    -->
    <Style x:Key="Icon.Default" TargetType="{x:Type ui:Icon}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Icon}">
                    <Viewbox Width="{TemplateBinding Size}"
                             Height="{TemplateBinding Size}"
                             Stretch="Uniform"
                             StretchDirection="Both">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="PART_Path"
                                  Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Fill="{x:Null}"/>
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFilled" Value="True">
                            <Setter TargetName="PART_Path" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            <Setter TargetName="PART_Path" Property="Stroke" Value="{x:Null}"/>
                            <Setter TargetName="PART_Path" Property="StrokeThickness" Value="0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type ui:Icon}" BasedOn="{StaticResource Icon.Default}"/>

</ResourceDictionary>
