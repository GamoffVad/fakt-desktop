<!--
    FAKT · Arctic Blue · buttons (DESIGN.md §6.1) and shared focus visuals.

    One template (Button.Template) serves every variant. State colours are component tokens
    (Button.*.Background / Button.*.Border) resolved with DynamicResource from the variant's
    Style.Resources. Each component brush uses the same primitive as the semantic brush named
    in its comment (.NET Framework BAML cannot alias a resource with <StaticResource x:Key/>
    inside a deferred dictionary). States are template-local layers:
        Base (Normal) < HoverLayer (fades 120 ms) < PressedLayer < DisabledLayer.
    Disabled covers everything, so it blocks hover/pressed. Keyboard focus is a separate 2 DIP
    frame drawn 2 DIP outside the control by FocusVisualStyle (no size change).

    Attached properties (xmlns:ui="clr-namespace:Fakt.Desktop.Controls"):
        ui:Ui.Icon   - Geometry shown in a 20 DIP slot, 8 DIP before the text.
        ui:Ui.IsBusy - replaces the icon by a spinner of the same size (the command must still
                       block re-execution; show a process verb, e.g. «Проверка…»).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:ui="clr-namespace:Fakt.Desktop.Controls"
                    mc:Ignorable="po">

    <!-- Token dictionaries referenced with StaticResource by this file (StaticResource does not
         see sibling merged dictionaries, so every dictionary merges what it needs itself). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../ArcticBlue.Semantic.xaml"/>
        <ResourceDictionary Source="../ArcticBlue.Metrics.xaml"/>
        <ResourceDictionary Source="../ArcticBlue.Typography.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- ===================== Focus visuals ===================== -->

    <!-- 2 DIP frame, 2 DIP outside a control with radius 6 (buttons, inputs, nav items, tabs). -->
    <Style x:Key="FocusVisual.Control">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.Focus.Outset}"
                            BorderThickness="{StaticResource Thickness.Focus}"
                            CornerRadius="{StaticResource Radius.Focus}"
                            BorderBrush="{DynamicResource Brush.Focus}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same, for small elements with radius 4 (check boxes, radio buttons, splitter). -->
    <Style x:Key="FocusVisual.Small">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="{StaticResource Thickness.Focus.Outset}"
                            BorderThickness="{StaticResource Thickness.Focus}"
                            CornerRadius="{StaticResource Radius.Focus.Small}"
                            BorderBrush="{DynamicResource Brush.Focus}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 2 DIP frame INSIDE the element (DataGrid cells, list items): never clipped by neighbours. -->
    <Style x:Key="FocusVisual.Inner">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderThickness="{StaticResource Thickness.Focus}"
                            CornerRadius="2"
                            BorderBrush="{DynamicResource Brush.Focus}"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Shared button template ===================== -->

    <ControlTemplate x:Key="Button.Template" TargetType="{x:Type ButtonBase}">
        <Grid x:Name="Root" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <!--
                Each state layer = full-size fill + outline drawn on top of it. (A single Border insets
                its background by the border width, which leaves a light seam at 125/150/175 % DPI.)
            -->
            <Grid x:Name="BaseLayer">
                <Border Background="{TemplateBinding Background}" CornerRadius="{StaticResource Radius.Control}"/>
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"/>
            </Grid>
            <Grid x:Name="HoverLayer" Opacity="0">
                <Border Background="{DynamicResource Button.Hover.Background}" CornerRadius="{StaticResource Radius.Control}"/>
                <Border BorderBrush="{DynamicResource Button.Hover.Border}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"/>
            </Grid>
            <Grid x:Name="PressedLayer" Opacity="0">
                <Border Background="{DynamicResource Button.Pressed.Background}" CornerRadius="{StaticResource Radius.Control}"/>
                <Border BorderBrush="{DynamicResource Button.Pressed.Border}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"/>
            </Grid>
            <Grid x:Name="DisabledLayer" Visibility="Collapsed">
                <Border Background="{DynamicResource Button.Disabled.Background}" CornerRadius="{StaticResource Radius.Control}"/>
                <Border BorderBrush="{DynamicResource Button.Disabled.Border}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Radius.Control}"/>
            </Grid>

            <Grid x:Name="ContentHost"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon slot: 20×20; the spinner replaces the icon without changing the size. -->
                <Grid x:Name="IconSlot"
                      Width="{StaticResource Size.Icon.Default}"
                      Height="{StaticResource Size.Icon.Default}"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <ui:Icon x:Name="IconGlyph"
                             Size="{StaticResource Size.Icon.Default}"
                             Data="{Binding Path=(ui:Ui.Icon), RelativeSource={RelativeSource TemplatedParent}}"/>
                    <Grid x:Name="Spinner" Visibility="Collapsed" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </Grid.RenderTransform>
                        <Ellipse Margin="2"
                                 StrokeThickness="2"
                                 Opacity="0.3"
                                 Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                        <Path Data="M10,3 A7,7 0 0 1 17,10"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              Stroke="{Binding Path=(TextElement.Foreground), RelativeSource={RelativeSource Self}}"/>
                    </Grid>
                </Grid>

                <ContentPresenter x:Name="ContentSite"
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Grid>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="ui:Ui.Icon" Value="{x:Null}">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="HasContent" Value="False">
                <Setter TargetName="IconSlot" Property="Margin" Value="0"/>
                <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="ui:Ui.IsBusy" Value="True">
                <Setter TargetName="IconSlot" Property="Visibility" Value="Visible"/>
                <Setter TargetName="IconGlyph" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Spinner" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                    <BeginStoryboard x:Name="SpinStoryboard">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Spinner"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                             From="0" To="360" Duration="0:0:0.9"
                                             RepeatBehavior="Forever"/>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <RemoveStoryboard BeginStoryboardName="SpinStoryboard"/>
                </Trigger.ExitActions>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsEnabled" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="{StaticResource Duration.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.EnterActions>
                <MultiTrigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLayer" Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="{StaticResource Duration.Hover}"/>
                        </Storyboard>
                    </BeginStoryboard>
                </MultiTrigger.ExitActions>
            </MultiTrigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="PressedLayer" Property="Opacity" Value="1"/>
            </Trigger>
            <!-- Last: disabled wins over everything above. -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="DisabledLayer" Property="Visibility" Value="Visible"/>
                <Setter TargetName="PressedLayer" Property="Opacity" Value="0"/>
                <Setter TargetName="ContentHost" Property="TextElement.Foreground" Value="{DynamicResource Brush.Disabled.Foreground}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- ===================== Variants ===================== -->

    <Style x:Key="Button.Base" TargetType="{x:Type ButtonBase}">
        <Style.Resources>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Color.Blue.50}" po:Freeze="True"/> <!-- = Brush.Background.Subtle -->
            <SolidColorBrush x:Key="Button.Hover.Border" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/> <!-- = Brush.Border.Input -->
            <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource Color.Blue.200}" po:Freeze="True"/> <!-- = Brush.Selection -->
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/> <!-- = Brush.Border.Input -->
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
        </Style.Resources>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{DynamicResource FocusVisual.Control}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="{StaticResource Thickness.Button.Padding}"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template" Value="{StaticResource Button.Template}"/>
    </Style>

    <!-- Main action («Импортировать», «Выбрать папку»): Ocean fill, white text. -->
    <Style x:Key="Button.Primary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Button.Base}">
        <Style.Resources>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Color.Ocean.700}" po:Freeze="True"/> <!-- = Brush.Action.Hover -->
            <SolidColorBrush x:Key="Button.Hover.Border" Color="{StaticResource Color.Ocean.700}" po:Freeze="True"/> <!-- = Brush.Action.Hover -->
            <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource Color.Ocean.800}" po:Freeze="True"/> <!-- = Brush.Action.Pressed -->
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource Color.Ocean.800}" po:Freeze="True"/> <!-- = Brush.Action.Pressed -->
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Brush.Action.Primary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Action.Primary}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.OnAction}"/>
    </Style>

    <!-- Secondary action («Проверить»): white, Border.Input outline, Navy text. -->
    <Style x:Key="Button.Secondary" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Button.Base}">
        <Style.Resources>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Color.Blue.50}" po:Freeze="True"/> <!-- = Brush.Background.Subtle -->
            <SolidColorBrush x:Key="Button.Hover.Border" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/> <!-- = Brush.Border.Input -->
            <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource Color.Blue.200}" po:Freeze="True"/> <!-- = Brush.Selection -->
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/> <!-- = Brush.Border.Input -->
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
    </Style>

    <!--
        Toolbar action without chrome («Обновить»). Hover uses Background.Navigation (Blue.100):
        Background.Subtle (Blue.50) is only 1.05:1 against White and would be imperceptible
        on a borderless button.
    -->
    <Style x:Key="Button.Ghost" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Button.Base}">
        <Style.Resources>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Color.Blue.100}" po:Freeze="True"/> <!-- = Brush.Background.Navigation -->
            <SolidColorBrush x:Key="Button.Hover.Border" Color="{StaticResource Color.Blue.100}" po:Freeze="True"/> <!-- = Brush.Background.Navigation -->
            <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource Color.Blue.200}" po:Freeze="True"/> <!-- = Brush.Selection -->
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource Color.Blue.200}" po:Freeze="True"/> <!-- = Brush.Selection -->
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="Transparent" po:Freeze="True"/>
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="Transparent" po:Freeze="True"/>
        </Style.Resources>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Padding" Value="12,0"/>
    </Style>

    <!-- Square 40×40 icon-only button. Always set ToolTip and AutomationProperties.Name. -->
    <Style x:Key="Button.Icon" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Button.Ghost}">
        <Setter Property="MinWidth" Value="{StaticResource Size.Control}"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Control}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Destructive / stopping action («Остановить»): secondary look with Red.700 text and icon. -->
    <Style x:Key="Button.Danger" TargetType="{x:Type ButtonBase}" BasedOn="{StaticResource Button.Base}">
        <Style.Resources>
            <SolidColorBrush x:Key="Button.Hover.Background" Color="{StaticResource Color.Red.50}" po:Freeze="True"/> <!-- = Brush.Status.ErrorBackground -->
            <SolidColorBrush x:Key="Button.Hover.Border" Color="{StaticResource Color.Slate.400}" po:Freeze="True"/> <!-- = Brush.Border.Input -->
            <SolidColorBrush x:Key="Button.Pressed.Background" Color="{StaticResource Color.Red.100}" po:Freeze="True"/> <!-- = Brush.Status.ErrorBackgroundStrong -->
            <SolidColorBrush x:Key="Button.Pressed.Border" Color="{StaticResource Color.Red.700}" po:Freeze="True"/> <!-- = Brush.Status.Error -->
            <SolidColorBrush x:Key="Button.Disabled.Background" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
            <SolidColorBrush x:Key="Button.Disabled.Border" Color="{StaticResource Color.Slate.200}" po:Freeze="True"/> <!-- = Brush.Disabled.Background -->
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource Brush.Background.Surface}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Input}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}"/>
    </Style>

    <!-- Plain <Button/> without a style gets the secondary look instead of the OS theme. -->
    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource Button.Secondary}"/>

</ResourceDictionary>
