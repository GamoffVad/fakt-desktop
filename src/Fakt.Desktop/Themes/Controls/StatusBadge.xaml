<!--
    FAKT · Arctic Blue · status badges (DESIGN.md §6.6).
    <ui:StatusBadge Text="Табличный" Tone="Success"/>
    <ui:StatusBadge Text="Готов к импорту" Tone="Success" Icon="{StaticResource Icon.Check}"/>
    MinHeight 24, padding 8 horizontal, radius 10, 12 DIP semibold text. The text is always shown;
    the tone colours text and icon on the matching light background.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Fakt.Desktop.Controls">

    <Style x:Key="StatusBadge.Default" TargetType="{x:Type ui:StatusBadge}">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Background" Value="{DynamicResource Brush.Status.NeutralBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Neutral}"/>
        <!-- Neutral keeps a subtle outline: Blue.50 alone is almost invisible on white rows. -->
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.NeutralBorder}"/>
        <Setter Property="BorderThickness" Value="{StaticResource Thickness.Border}"/>
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="{StaticResource Size.Badge}"/>
        <Setter Property="Padding" Value="{StaticResource Thickness.Badge.Padding}"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="UseLayoutRounding" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:StatusBadge}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource Radius.Badge}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:Icon x:Name="Glyph"
                                     Margin="0,0,4,0"
                                     Size="{StaticResource Size.Icon.Badge}"
                                     Data="{TemplateBinding Icon}"/>
                            <TextBlock x:Name="Label"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Text="{TemplateBinding Text}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Tone" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.InfoBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.InfoBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Info}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.SuccessBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.SuccessBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Success}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.WarningBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.WarningBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Warning}"/>
            </Trigger>
            <Trigger Property="Tone" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Brush.Status.ErrorBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.ErrorBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="{x:Type ui:StatusBadge}" BasedOn="{StaticResource StatusBadge.Default}"/>

</ResourceDictionary>
