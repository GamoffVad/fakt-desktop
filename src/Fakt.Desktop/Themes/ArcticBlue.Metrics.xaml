<!--
    FAKT · Arctic Blue · geometry tokens (DESIGN.md §3.3). All values are DIP; base step is 4.
    Immutable values: templates may use StaticResource for them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Spacing scale -->
    <sys:Double x:Key="Space.1">4</sys:Double>
    <sys:Double x:Key="Space.2">8</sys:Double>
    <sys:Double x:Key="Space.3">12</sys:Double>
    <sys:Double x:Key="Space.4">16</sys:Double>
    <sys:Double x:Key="Space.6">24</sys:Double>
    <sys:Double x:Key="Space.8">32</sys:Double>

    <!-- Control and layout sizes -->
    <sys:Double x:Key="Size.Control">40</sys:Double>
    <sys:Double x:Key="Size.Control.Compact">32</sys:Double>
    <sys:Double x:Key="Size.Table.Row">40</sys:Double>
    <sys:Double x:Key="Size.Table.Header">36</sys:Double>
    <sys:Double x:Key="Size.Icon.Tiny">12</sys:Double>
    <sys:Double x:Key="Size.Icon.Badge">14</sys:Double>
    <sys:Double x:Key="Size.Icon.Small">16</sys:Double>
    <sys:Double x:Key="Size.Icon.Default">20</sys:Double>
    <sys:Double x:Key="Size.Icon.Navigation">24</sys:Double>
    <sys:Double x:Key="Size.Nav.Width">216</sys:Double>
    <sys:Double x:Key="Size.Nav.Compact">64</sys:Double>
    <sys:Double x:Key="Size.Nav.Item">48</sys:Double>
    <sys:Double x:Key="Size.Header">64</sys:Double>
    <sys:Double x:Key="Size.Badge">24</sys:Double>
    <sys:Double x:Key="Size.CheckBox">18</sys:Double>
    <sys:Double x:Key="Size.Dropdown.Item">36</sys:Double>
    <sys:Double x:Key="Size.Progress">6</sys:Double>
    <sys:Double x:Key="Size.Scrollbar">12</sys:Double>
    <sys:Double x:Key="Size.Splitter">8</sys:Double>
    <sys:Double x:Key="Size.ToolTip.MaxWidth">480</sys:Double>

    <!-- Thickness -->
    <Thickness x:Key="Thickness.Panel">16</Thickness>
    <Thickness x:Key="Thickness.Page">24</Thickness>
    <Thickness x:Key="Thickness.Button.Padding">16,0</Thickness>
    <Thickness x:Key="Thickness.Input.Padding">12,0</Thickness>
    <Thickness x:Key="Thickness.Cell.Padding">12,0</Thickness>
    <Thickness x:Key="Thickness.Nav.Padding">12,0</Thickness>
    <Thickness x:Key="Thickness.Badge.Padding">8,0</Thickness>
    <Thickness x:Key="Thickness.Banner.Padding">12</Thickness>
    <Thickness x:Key="Thickness.ToolTip.Padding">8,4</Thickness>
    <Thickness x:Key="Thickness.Border">1</Thickness>
    <Thickness x:Key="Thickness.Focus">2</Thickness>
    <!-- Focus frame: 2 DIP stroke drawn 2 DIP outside the control (does not change its size). -->
    <Thickness x:Key="Thickness.Focus.Outset">-4</Thickness>

    <!-- Corner radii -->
    <CornerRadius x:Key="Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Radius.Panel">6</CornerRadius>
    <CornerRadius x:Key="Radius.Badge">10</CornerRadius>
    <CornerRadius x:Key="Radius.Small">4</CornerRadius>
    <CornerRadius x:Key="Radius.Progress">3</CornerRadius>
    <!-- Outer radius of the focus frame around a Radius.Control / Radius.Small element (radius + 4). -->
    <CornerRadius x:Key="Radius.Focus">10</CornerRadius>
    <CornerRadius x:Key="Radius.Focus.Small">8</CornerRadius>

</ResourceDictionary>
