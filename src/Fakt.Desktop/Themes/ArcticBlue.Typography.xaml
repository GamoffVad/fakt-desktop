<!--
    FAKT · Arctic Blue · typography (DESIGN.md §4).
    TextBlock styles are KEYED on purpose: an implicit TextBlock style would leak into every
    ContentPresenter inside control templates. Colour is inherited unless the style is semantic
    (headings, secondary, caption, error).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Families. Segoe UI ships with Windows 7+ and covers Cyrillic; Consolas ships with Vista+. -->
    <FontFamily x:Key="Font.Primary">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Mono">Consolas</FontFamily>

    <!-- Sizes (DIP) -->
    <sys:Double x:Key="FontSize.Display">28</sys:Double>
    <sys:Double x:Key="FontSize.Page">24</sys:Double>
    <sys:Double x:Key="FontSize.Section">18</sys:Double>
    <sys:Double x:Key="FontSize.Body">14</sys:Double>
    <sys:Double x:Key="FontSize.Caption">12</sys:Double>
    <sys:Double x:Key="FontSize.Metric">24</sys:Double>
    <sys:Double x:Key="FontSize.Mono">13</sys:Double>

    <!-- Line heights for wrapping text (≈ 1.4 × size) -->
    <sys:Double x:Key="LineHeight.Body">20</sys:Double>
    <sys:Double x:Key="LineHeight.Caption">17</sys:Double>

    <!-- Base: family only, so that colour and size stay inheritable. -->
    <Style x:Key="Text.Base" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Primary}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- «FAKT» in the product header: 28 Semibold -->
    <Style x:Key="Text.Display.Brand" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- «Импорт файлов»: 24 Semibold -->
    <Style x:Key="Text.Heading.Page" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Page}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Panel headings: 18 Semibold -->
    <Style x:Key="Text.Heading.Section" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Section}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Body: 14 Normal, wraps with 1.4 line height -->
    <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Label: 14 Semibold (significant captions, toolbar labels) -->
    <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- Caption: 12 Normal, secondary colour (metadata, hints) -->
    <Style x:Key="Text.Caption" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Metric counters («Найдено 24»): 24 Semibold, tabular digits -->
    <Style x:Key="Text.Metric" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Metric}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Secondary body text: 14 Normal, Slate.600, wraps -->
    <Style x:Key="Text.Secondary" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Body}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Permanent label above an input («Папка»): 14 Semibold, 4 DIP gap to the field -->
    <Style x:Key="Text.FieldLabel" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Validation message under/next to a field: 12, Red.700 -->
    <Style x:Key="Text.Error" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="{StaticResource LineHeight.Caption}"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    </Style>

    <!-- Monospace (JSON, model IDs, codes) - never for the whole UI -->
    <Style x:Key="Text.Mono" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Mono}"/>
    </Style>

    <!-- DataGrid cell text (DataGridTextColumn.ElementStyle): single line, ellipsis, centred -->
    <Style x:Key="Text.Cell" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Base}">
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Numeric cell: right aligned, tabular digits -->
    <Style x:Key="Text.Cell.Numeric" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource Text.Cell}">
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>

    <!-- Links: Ocean.700 (5.4:1 on Ice.50, 6.0:1 on White); Ocean.600 would fail 4.5:1 on Ice.50. -->
    <Style TargetType="{x:Type Hyperlink}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Link}"/>
        <Setter Property="TextDecorations" Value="Underline"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Action.Pressed}"/>
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.Selection}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Disabled.Foreground}"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
